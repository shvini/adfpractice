{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"name": "sourceCSV"
				}
			],
			"sinks": [
				{
					"name": "datasink"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "filtercustomer"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn"
				},
				{
					"name": "aggregate"
				},
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          transaction_id as short,",
				"          transactional_date as timestamp,",
				"          product_id as string,",
				"          customer_id as short,",
				"          payment as string,",
				"          credit_card as long,",
				"          loyalty_card as boolean,",
				"          cost as double,",
				"          quantity as short,",
				"          price as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false) ~> sourceCSV",
				"sourceCSV select(mapColumn(",
				"          transaction_id,",
				"          transactional_date,",
				"          product_id,",
				"          customer_id,",
				"          payment,",
				"          price",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 filter(customer_id !=12) ~> filtercustomer",
				"filtercustomer split(payment=='visa',",
				"     payment=='mastercard',",
				"     disjoint: false) ~> split1@(visa, mastercard, amex)",
				"split1@amex derive(payment = coalesce(payment,'N/A')) ~> derivedColumn",
				"split1@visa aggregate(groupBy(customer_id),",
				"     product_id = max(product_id)) ~> aggregate",
				"aggregate alterRow(upsertIf('ash'=='ash')) ~> alterRow1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     preCommands: [],",
				"     postCommands: []) ~> datasink"
			]
		}
	}
}